{
  "name": "fastgpt-cli",
  "version": "0.1.0",
  "description": "命令行管理 FastGPT：工作流 DSL 构建、知识库文档与 QA 导入、权限配置、发布渠道、运行调试",
  "type": "module",
  "bin": {
    "fastgpt": "./bin/fastgpt.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "lib",
    "examples",
    "tests",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fastgpt",
    "cli",
    "workflow",
    "rag",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node tests/smoke.mjs",
    "test:validate": "node bin/fastgpt.mjs wf validate examples/dsl-contract-review.json",
    "test:all": "node tests/smoke.mjs && node bin/fastgpt.mjs wf validate examples/dsl-contract-review.json"
  }
}